<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="borderCarts"
           TargetType="Border"
           >
        <Setter Property="BorderBrush"
            Value="{DynamicResource BorderBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="borderNav" TargetType="Border">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource MaterialDesignShadow}" 
                                  Direction="200" 
                                  ShadowDepth="0" 
                                  BlurRadius="25" 
                                  Opacity="0.4" RenderingBias="Performance"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="PasswordPopupBorder"
       TargetType="Border">
        <Setter Property="Height" Value="270"/>
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Width" Value="320"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25"/>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="SearchContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="DialogContentBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="MinWidth" Value="420"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>

    </Style>

    <Style x:Key="KpiCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20 16"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12"
                              ShadowDepth="2" Direction="270"
                                  Opacity="0.12"
                              Color="#000000"
                              RenderingBias="Performance"/>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>