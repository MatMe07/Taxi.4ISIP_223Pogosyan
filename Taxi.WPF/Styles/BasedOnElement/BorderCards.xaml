<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="borderCarts"
           TargetType="Border"
           >
        <Setter Property="BorderBrush"
            Value="{DynamicResource BorderBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="borderNav" TargetType="Border">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource MaterialDesignShadow}" 
                                  Direction="200" 
                                  ShadowDepth="0" 
                                  BlurRadius="25" 
                                  Opacity="0.4" RenderingBias="Performance"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
</ResourceDictionary>