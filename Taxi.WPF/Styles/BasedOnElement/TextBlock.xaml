<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="AppTextBlockTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MaterialDesignHeadline2TextBlock}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource TextBlockPrimaryBrush}"/>
    </Style>

    <Style x:Key="AppTextBlockSubtitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MaterialDesignTextBlock}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground"
                Value="{DynamicResource TextBlockSecondaryBrush}"/>
    </Style>

    <Style x:Key="AppTextBlockBody"
           TargetType="TextBlock"
           BasedOn="{StaticResource MaterialDesignTextBlock}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground"
                Value="{DynamicResource TextBlockPrimaryBrush}"/>
    </Style>

    <Style x:Key="AppTextBlockCaption"
           TargetType="TextBlock"
           BasedOn="{StaticResource MaterialDesignTextBlock}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground"
                Value="{DynamicResource TextBlockSecondaryBrush}"/>
    </Style>

    <Style x:Key="TextBlockTabItem"
           TargetType="TextBlock"
           BasedOn="{StaticResource MaterialDesignTextBlock}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
        
    </Style>
    <Style x:Key="AppFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
        <Setter Property="FontSize"    Value="12"/>
        <Setter Property="Margin"      Value="0 6 0 2"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextBlockLabelBrush}"/>
    </Style>
    <Style x:Key="AppReadOnlyValue" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
        <Setter Property="FontSize"    Value="15"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextBlockPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="AppKpiValue" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBlockPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0 4 0 0"/>
    </Style>

    <Style x:Key="AppKpiCaption" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBlockSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>


    <Style x:Key="KpiTitle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBlockSecondaryBrush}"/>
        <Setter Property="Margin" Value="0 0 0 6"/>
    </Style>

    <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBlockPrimaryBrush}"/>
    </Style>
</ResourceDictionary>