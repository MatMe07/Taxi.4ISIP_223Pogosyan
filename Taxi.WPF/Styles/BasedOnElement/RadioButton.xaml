<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="AppRadioButton" TargetType="{x:Type RadioButton}"
       BasedOn="{StaticResource MaterialDesignRadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource TextBlockPrimaryBrush}"/>
        <Setter Property="Margin"     Value="0 4 24 0"/>
        <Setter Property="FontSize"   Value="14"/>
    </Style>
</ResourceDictionary>