<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Style x:Key="checkBoxActive" TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignFilterChipSecondaryCheckBox}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundBrush}"/>
                <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundBrush}"/>
            </Trigger>

            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource CheckBoxActiveForegroundBrush}"/>
                <Setter Property="Background" Value="{DynamicResource CheckBoxActiveBackgroundBrush}"/>
            </Trigger>  
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>