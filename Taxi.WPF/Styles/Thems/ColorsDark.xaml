<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBrush"          Color="#4A90E2"/>

    <SolidColorBrush x:Key="AppBackgroundBrush"    Color="#191917"/>
    <SolidColorBrush x:Key="SurfaceBrush"          Color="#1A2028"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"       Color="#242C36"/>

    <SolidColorBrush x:Key="BorderBrush"           Color="#2D3742"/>
    <SolidColorBrush x:Key="DividerBrush"          Color="#232B34"/>

    <SolidColorBrush x:Key="IconBrush"       Color="#E8EDF2"/>
    <SolidColorBrush x:Key="TextBlockPrimaryBrush"       Color="#E8EDF2"/>
    <SolidColorBrush x:Key="TextBlockSecondaryBrush"     Color="#A0AEBD"/>
    <SolidColorBrush x:Key="TextBlockOnDarkBrush"        Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextBlockHeaderBrush"        Color="#F0F4F8"/>
    <SolidColorBrush x:Key="TextBlockLabelBrush"         Color="#B8C4D0"/>
    <SolidColorBrush x:Key="TextBlockPlaceholderBrush"   Color="#5A6773"/>

    <SolidColorBrush x:Key="DangerBrush"           Color="#FC8181"/>

    <SolidColorBrush x:Key="CheckBoxBackgroundBrush"         Color="#242C36"/>
    <SolidColorBrush x:Key="CheckBoxForegroundBrush"         Color="#E8EDF2"/>
    <SolidColorBrush x:Key="CheckBoxActiveBackgroundBrush"   Color="#4A90E2"/>
    <SolidColorBrush x:Key="CheckBoxActiveForegroundBrush"   Color="#0F1419"/>

    <SolidColorBrush x:Key="ButtonPrimaryBackgroundBrush"        Color="#1E5AA8"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBackgroundBrush"   Color="#164A8C"/>
    <SolidColorBrush x:Key="ButtonPrimaryPressedBackgroundBrush" Color="#0F3A70"/>
    <SolidColorBrush x:Key="ButtonPrimaryForegroundBrush"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonPrimaryBorderBrush"            Color="Transparent"/>

</ResourceDictionary>
