<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" InvalidatesImplicitDataTemplateResources="False">

    <SolidColorBrush x:Key="PrimaryBrush"          Color="#1E5AA8"/>

    <SolidColorBrush x:Key="AppBackgroundBrush"    Color="#F5F7FA"/>
    <SolidColorBrush x:Key="SurfaceBrush"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"       Color="#EEF2F7"/>

    <SolidColorBrush x:Key="BorderBrush"           Color="#E2E8F0"/>
    <SolidColorBrush x:Key="DividerBrush"          Color="#EDF2F7"/>

    <SolidColorBrush x:Key="IconBrush"          Color="#1A202C"/>
    <SolidColorBrush x:Key="TextBlockPrimaryBrush"          Color="#1A202C"/>
    <SolidColorBrush x:Key="TextBlockSecondaryBrush"        Color="#64748B"/>
    <SolidColorBrush x:Key="TextBlockOnDarkBrush"           Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextBlockHeaderBrush"           Color="#2D3748"/>
    <SolidColorBrush x:Key="TextBlockLabelBrush"            Color="#4A5568"/>
    <SolidColorBrush x:Key="TextBlockPlaceholderBrush"      Color="#A0AEC0"/>

    <SolidColorBrush x:Key="DangerBrush"           Color="#E53E3E"/>

    <SolidColorBrush x:Key="CheckBoxBackgroundBrush"         Color="#F5F7FA"/>
    <SolidColorBrush x:Key="CheckBoxForegroundBrush"         Color="#1A202C"/>
    <SolidColorBrush x:Key="CheckBoxActiveBackgroundBrush"   Color="#1E5AA8"/>
    <SolidColorBrush x:Key="CheckBoxActiveForegroundBrush"   Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ButtonPrimaryBackgroundBrush"        Color="#4A90E2"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBackgroundBrush"   Color="#5BA0F2"/>
    <SolidColorBrush x:Key="ButtonPrimaryPressedBackgroundBrush" Color="#3A7BC8"/>
    <SolidColorBrush x:Key="ButtonPrimaryForegroundBrush"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonPrimaryBorderBrush"            Color="Transparent"/>

</ResourceDictionary>
