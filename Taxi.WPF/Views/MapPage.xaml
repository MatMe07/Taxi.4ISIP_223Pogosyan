<Page x:Class="Taxi.src.Taxi.Map.MapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Taxi.src.Taxi.Map"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
              xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      d:Background="White"
      Title="MapPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button  Content="Click" Margin="5" Padding="5" HorizontalAlignment="Left" Click="Button_Click"/>
        <wv2:WebView2 Name="MyWebView" Grid.Row="1" />

    </Grid>
</Page>
