<UserControl x:Class="Taxi.WPF.Views.Dialogs.EditCarUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Taxi.WPF.ViewModels.DialogsVM"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DataContext="{d:DesignInstance {x:Type local:EditCarViewModel}}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="480">
    <Border Style="{DynamicResource DialogContentBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0 0 0 10">
                <TextBlock Text="Редактирование  ТС"
                               Style="{DynamicResource AppTextBlockTitle}"
                               VerticalAlignment="Center"/>
                <Button Style="{StaticResource MaterialDesignToolButton}"
                            HorizontalAlignment="Right"
                            Width="32" Height="32"
                            Foreground="{DynamicResource IconBrush}"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Height="1"
                        Background="{DynamicResource DividerBrush}"
                        Margin="0 0 0 12"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <TextBlock Text="Госномер" Style="{DynamicResource AppFieldLabel}"/>
                    <Grid Margin="0 0 0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Lock"
                                                     Width="18" Height="18"
                                                     Grid.Column="0"
                                                     Margin="0 0 8 0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource TextBlockSecondaryBrush}"/>
                        <TextBox Grid.Column="1"
                                     Style="{StaticResource AppTextBoxReadOnly}"
                                     Margin="0"
                                     Text="{Binding EditVehicle.LicensePlate, Mode=OneWay}"/>
                    </Grid>

                    <TextBlock Text="Марка *" Style="{DynamicResource AppFieldLabel}"/>
                    <TextBox Style="{StaticResource AppTextBox}"
                                 Margin="0 0 0 5"
                                 Text="{Binding NewVehicle.Brand, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Toyota"/>

                    <TextBlock Text="Модель *" Style="{DynamicResource AppFieldLabel}"/>
                    <TextBox Style="{StaticResource AppTextBox}"
                                 Margin="0 0 0 5"
                                 Text="{Binding NewVehicle.Model, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Camry"/>

                    <Grid Margin="0 6 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Класс ТС *" Style="{DynamicResource AppFieldLabel}"/>
                            <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                                          Margin="0"
                                          materialDesign:HintAssist.Hint="Класс"
                                          ItemsSource="{Binding VehicleClasses}"
                                          SelectedItem="{Binding NewVehicle.VehicleClass}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Год выпуска *" Style="{DynamicResource AppFieldLabel}"/>
                            <ComboBox Style="{DynamicResource FilterComboBoxStyle}"
                                          Margin="0"
                                          materialDesign:HintAssist.Hint="Год"
                                          ItemsSource="{Binding Years}"
                                          SelectedItem="{Binding NewVehicle.Year}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Статус в системе" Style="{DynamicResource AppFieldLabel}" Margin="0 12 0 2"/>
                    <CheckBox Content="Активен"
                                         IsChecked="{Binding NewVehicle.IsActive}"/>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Height="1"
                        Background="{DynamicResource DividerBrush}"
                        Margin="0 16 0 12"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                            Content="Удалить"
                            Style="{StaticResource DialogDangerButtonStyle}"
                            Command="{Binding DeleteVehicleCommand}"/>

                <Button Grid.Column="2"
                            Content="Отмена" Margin="10 0 0 0"
                            Style="{StaticResource DialogCancelButtonStyle}"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>

                <Button Grid.Column="3"
                            Content="Сохранить изменения"
                            Style="{StaticResource DialogButtonStyle}"
                            Command="{Binding SaveVehicleCommand}"/>
            </Grid>
        </Grid>
    </Border>

</UserControl>
