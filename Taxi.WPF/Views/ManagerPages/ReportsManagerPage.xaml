<Page x:Class="Taxi.WPF.Views.ManagerPages.ReportsManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Taxi.WPF.ViewModels.ManagerViewModels"
      xmlns:localConvert="clr-namespace:Taxi.WPF.Converters"
      
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:uc="clr-namespace:Taxi.WPF.Views.Diagramms"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"

      d:DataContext="{d:DesignInstance {x:Type local:ReportsManagerViewModel}}"
      mc:Ignorable="d" 
      
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DataAuto"
       
      Background="{DynamicResource AppBackgroundBrush}"
      >
    <Page.Resources>
        <localConvert:BoolToVisibilityConverter x:Key="boolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0 15">
            <TextBlock Text="Отчеты" Style="{DynamicResource AppTextBlockTitle}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Период" Margin="0 0 10 5" Style="{DynamicResource AppTextBlockBody}" VerticalAlignment="Bottom"/>
                <DatePicker x:Name="StartDatePicker"
                Width="150"
                Margin="5"
                Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                materialDesign:HintAssist.Hint="Дата начала"
                SelectedDateChanged="StartDatePicker_SelectedDateChanged"
                            SelectedDate="{Binding SelectStartDate}"
                            />

                <DatePicker x:Name="EndDatePicker"
                Width="150"
                Margin="5"
                Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                materialDesign:HintAssist.Hint="Дата окончания"
                SelectedDateChanged="EndDatePicker_SelectedDateChanged"
                            SelectedDate="{Binding SelectEndDate}"
                            />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="15 0" Grid.Row="1">
                    <materialDesign:PackIcon Kind="FilterCogOutline" Height="25" Width="25" Foreground="{DynamicResource IconBrush}"/>
                    <ComboBox Margin="5 0 5 5" Width="150" Padding="5"
       Style="{StaticResource FilterComboBoxStyle}"
       materialDesign:HintAssist.Hint="Класс" ItemsSource="{Binding SortClasses}"
       SelectedItem="{Binding SelectedClassSort}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0 10">
                <Button Content="Сформировать" Height="35" Padding="20 0" Style="{DynamicResource buttonBased}"/>
                <Menu Margin="15 0 0 0" BorderBrush="#FFCA3E3E" BorderThickness="1" Visibility="{Binding VisibleDiagramBtn, Converter={StaticResource boolToVisibilityConverter}}">
                    <MenuItem Header="Экспорт">
                        <MenuItem Header="В Excel (.xlsx)"/>
                        <MenuItem Header="В PDF (.pdf)"/>
                        <MenuItem Header="В Word (.docx)"/>
                    </MenuItem>
                </Menu>
            </StackPanel>
            
            
        </Grid>

        <Grid Grid.Row="2"  Visibility="{Binding VisibleDiagramBtn, Converter={StaticResource boolToVisibilityConverter}}" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition />
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Width="300" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Margin="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"  Margin="10 20">
                        <TextBlock Text="Заказов"/>
                        <TextBlock Text="{Binding TotalCountOrder}"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Margin="10" Grid.Column="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"  Margin="10 20">
                        <TextBlock Text="Выручка"/>
                        <TextBlock Text="{Binding TotalEarning, StringFormat='\{0:F2} ₽'}"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <lvc:CartesianChart Grid.Row="1">

                <lvc:CartesianChart.Series>
                    <lvc:SeriesCollection>
                        <lvc:XamlColumnSeries
                    Values="{Binding Values1}"
                            />
                        
                    </lvc:SeriesCollection>
                </lvc:CartesianChart.Series>

                <lvc:CartesianChart.XAxes>
                    <lvc:AxesCollection>
                        <lvc:XamlAxis
                    AxisName="Госномер"
                    Labels="{Binding Labels}"/>
                    </lvc:AxesCollection>
                </lvc:CartesianChart.XAxes>

                <lvc:CartesianChart.YAxes>
                    <lvc:AxesCollection>
                        <lvc:XamlAxis
                    AxisName="Кол-во заказов"
                    NamePadding="0,15"
                    Labeler="{Binding Labeler}"
                    LabelsPaint="{lvc:SolidColorPaint
                        Color='#00f',
                        FontFamily='Times New Roman',
                        FontWeight=ExtraBold,
                        FontWidth=Normal,
                        FontSlant=Italic}"/>
                    </lvc:AxesCollection>
                </lvc:CartesianChart.YAxes>

            </lvc:CartesianChart>

        </Grid>

        <Grid Grid.Row="2" d:Visibility="Collapsed" Visibility="{Binding ClikedBtn, Converter={StaticResource boolToVisibilityConverter}}"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 30">
            <TextBlock Text="Нажите на кнопку &quot;Сформировать&quot;" Style="{DynamicResource MaterialDesignHeadline5TextBlock}"/>
        </Grid>
    </Grid>
</Page>
