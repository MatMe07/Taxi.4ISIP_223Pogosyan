<Page x:Class="Taxi.WPF.Views.ManagerAutoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Taxi.WPF.Views"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      
      mc:Ignorable="d" 
      d:Background="{StaticResource AppBackgroundBrush}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerAutoPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TabControl  Grid.Column="0" 
                          Style="{StaticResource TabControlStyle}"
                          TabStripPlacement="Left"
                     ItemContainerStyle="{StaticResource CustomTabItemStyle}"
                     >

            <TabItem  Tag="Автопарк" Margin="5">
                <TabItem.Header >
                    <StackPanel >
                        <materialDesign:PackIcon 
                                               Kind="car" />
                        <TextBlock HorizontalAlignment="Center" Text="Автопарк" />
                    </StackPanel>
                </TabItem.Header>


            </TabItem>
            <TabItem  Tag="ТО и ремонт" Margin="5">
                <TabItem.Header >
                    <StackPanel >
                        <materialDesign:PackIcon 
                                               Kind="Build" />
                        <TextBlock HorizontalAlignment="Center" Text="ТО и ремонт"/>
                    </StackPanel>
                </TabItem.Header>
            </TabItem>

            <TabItem   Tag="Топливо" Margin="5">
                <TabItem.Header >
                    <StackPanel >
                        <materialDesign:PackIcon 
                                               Kind="Fuel" />
                        <TextBlock HorizontalAlignment="Center" Text="Топливо" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem   Tag="Страхование" Margin="5">
                <TabItem.Header >
                    <StackPanel >
                        <materialDesign:PackIcon 
                                               Kind="ChartBar" />
                        <TextBlock HorizontalAlignment="Center" Text="Страхование" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem  Tag="Допуск ТС" Margin="5">
                <TabItem.Header >
                    <StackPanel >
                        <materialDesign:PackIcon 
                                               Kind="ChartBar" />
                        <TextBlock HorizontalAlignment="Center" Text="Допуск ТС" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem Tag="Отчёты" Margin="5">
                <TabItem.Header >
                    <StackPanel >
                        <materialDesign:PackIcon 
                                               Kind="Report" />
                        <TextBlock HorizontalAlignment="Center" Text="Отчёты" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
        </TabControl>
        <Frame Grid.Column="1"  NavigationUIVisibility="Hidden" x:Name="frameVehicles" Margin="10 0 0 0"/>
    </Grid>
</Page>
