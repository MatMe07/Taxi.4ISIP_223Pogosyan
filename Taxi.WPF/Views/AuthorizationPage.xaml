<Page x:Class="Taxi.WPF.Views.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Taxi.WPF.ViewModels"
      mc:Ignorable="d" 
      d:Background="White"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DesignHeight="450" d:DesignWidth="400" Width="400"
      Title="AuthorizationPage">
    <!--<Page.DataContext>
        <local:AuthorizationViewModel/>
    </Page.DataContext>-->
    <Grid>
        <TabControl Padding="10 0">
            <TabItem Header="Войти">

                <Border Padding="0 0 10 0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding txtLoginLogin}" materialDesign:HintAssist.Hint="Логин"
                                 Style="{DynamicResource AppTextBox}" Grid.Row="1"/>

                        <PasswordBox materialDesign:HintAssist.Hint="Пароль"
                                     Style="{DynamicResource AppPasswordBox}" Grid.Row="2" PasswordChanged="PasswordBoxLogin_PasswordChanged"/>


                        <Button Command="{Binding BtnSendLogin}"  Style="{DynamicResource buttonBased}" Content="Войти" Grid.Row="3" Margin="0 10"/>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Регистрация">

                <ScrollViewer>
                    <Border Padding="0 0 10 0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Text="{Binding txtLoginRegister}" materialDesign:HintAssist.Hint="Логин"
                                 Style="{DynamicResource AppTextBox}" Grid.Row="0"/>

                            <TextBox Text="{Binding txtFirstNameRegister}" materialDesign:HintAssist.Hint="Имя"
                                 Style="{DynamicResource AppTextBox}" Grid.Row="1"/>

                            <TextBox Text="{Binding txtLastNameRegister}" materialDesign:HintAssist.Hint="Фамилия"
                                 Style="{DynamicResource AppTextBox}" Grid.Row="2"/>

                            <TextBox Text="{Binding txtMiddleRegister}" materialDesign:HintAssist.Hint="Отчество"
                                 Style="{DynamicResource AppTextBox}" Grid.Row="3"/>

                            <TextBox Text="{Binding txtPhoneRegister}" materialDesign:HintAssist.Hint="Телефон"
                                 Style="{DynamicResource AppTextBox}" Grid.Row="4"/>

                            <PasswordBox   Style="{DynamicResource AppPasswordBox}" materialDesign:HintAssist.Hint="Пароль"
                                  Grid.Row="5" PasswordChanged="PasswordBoxRegister_PasswordChanged"/>

                            <PasswordBox   Style="{DynamicResource AppPasswordBox}" materialDesign:HintAssist.Hint="Подтверждение пароля"
                                  Grid.Row="6" PasswordChanged="PasswordBoxConfirm_PasswordChanged"/>



                            <Button Command="{Binding BtnSendRegister}" Margin="0 10 0 15" Style="{DynamicResource buttonBased}"  Content="Зарегистрироваться" Grid.Row="7" />
                        </Grid>

                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
