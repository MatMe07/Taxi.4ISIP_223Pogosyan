<Page x:Class="Taxi.WPF.Views.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Taxi.WPF.Converters"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      xmlns:localPsevd="clr-namespace:Taxi.WPF.ViewModels"
      mc:Ignorable="d" 
      d:Background="White"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" d:DesignWidth="400" Width="400"
      Title="AuthorizationPage">
    <!--<Page.DataContext>
        <local:AuthorizationViewModel/>
    </Page.DataContext>-->
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="boolToVisibleConverter"/>
    </Page.Resources>
    <Grid VerticalAlignment="Top" >
        <TabControl Padding="10 0" Style="{DynamicResource  TabControlStyle}" SelectedIndex="{Binding SelectItemTabControl, Mode=TwoWay}">
            <TabItem Header="Войти">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBox materialDesign:HintAssist.HelperTextFontSize="222" Text="{Binding txtLoginLogin}" materialDesign:HintAssist.Hint="Логин"
                                 Style="{DynamicResource AppTextBox}" Grid.Row="1" x:Name="txtBoxLogin"/>

                    <PasswordBox materialDesign:HintAssist.Hint="Пароль" x:Name="PasswordBoxLogin"
                                     Style="{DynamicResource AppPasswordBox}" Grid.Row="2" PasswordChanged="PasswordBoxLogin_PasswordChanged"/>
                    <Border Style="{DynamicResource borderCarts}" Grid.Row="3" Visibility="{Binding IsCaptchaVisible, Converter={StaticResource boolToVisibleConverter}}" 
                                 Padding="10 5" Height="60" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding CaptchaImage}" />
                            <!--<TextBlock Text="hello" Grid.Column="0" VerticalAlignment="Center"/>-->
                            <TextBox Text="{Binding txtCaptchaLogin}" materialDesign:HintAssist.Hint="Введите код с картинки" VerticalAlignment="Bottom" Grid.Column="1" />
                        </Grid>

                    </Border>

                    <Button Command="{Binding BtnSendLogin}"  Style="{DynamicResource buttonBased}" Content="Войти" Grid.Row="4" Margin="0 10"/>
                </Grid>
            </TabItem>
            <TabItem Header="Регистрация">

                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource MaterialDesignScrollViewer}">
                    <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Text="{Binding txtLoginRegister, Mode=TwoWay}" materialDesign:HintAssist.Hint="Логин"
                                 Style="{DynamicResource AppTextBox}" Grid.Row="0"/>

                            <TextBox Text="{Binding txtFirstNameRegister}" materialDesign:HintAssist.Hint="Имя"
                                 Style="{DynamicResource AppTextBox}" Grid.Row="1"/>

                            <TextBox Text="{Binding txtLastNameRegister}" materialDesign:HintAssist.Hint="Фамилия"
                                 Style="{DynamicResource AppTextBox}" Grid.Row="2"/>

                            <TextBox Text="{Binding txtMiddleRegister}" materialDesign:HintAssist.Hint="Отчество"
                                 Style="{DynamicResource AppTextBox}" Grid.Row="3"/>

                            <xctk:MaskedTextBox 
                                                
                                Text="{Binding txtPhoneRegister}" materialDesign:HintAssist.Hint="Телефон"
                                 Style="{DynamicResource TextBoxPhone}" Grid.Row="4"
                                />
                            <!--<TextBox />-->

                            <PasswordBox   Style="{DynamicResource AppPasswordBox}" x:Name="PasswordBoxRegister" materialDesign:HintAssist.Hint="Пароль"
                                  Grid.Row="5" PasswordChanged="PasswordBoxRegister_PasswordChanged"/>

                            <PasswordBox   Style="{DynamicResource AppPasswordBox}" x:Name="PasswordBoxRegisterConfirm" materialDesign:HintAssist.Hint="Подтверждение пароля"
                                  Grid.Row="6" PasswordChanged="PasswordBoxConfirm_PasswordChanged"/>



                            <Button Command="{Binding BtnSendRegister}" Margin="0 10 0 15" Style="{DynamicResource buttonBased}"  Content="Зарегистрироваться" Grid.Row="7" />
                        </Grid>

                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
