<Page x:Class="Taxi.WPF.Views.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Taxi.WPF.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="250" Width="250"
      Title="AuthorizationPage">
    <!--<Page.DataContext>
        <local:AuthorizationViewModel/>
    </Page.DataContext>-->
    <Grid>
        <TabControl>
            <TabItem Header="Войти">

                <Border Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Логин" Style="{DynamicResource TextBlockStyle}" Grid.Row="0"/>
                        <TextBox Text="{Binding txtLoginLogin}" Style="{DynamicResource TextBoxStyle}" Grid.Row="1"/>

                        <TextBlock Text="Пароль" Style="{DynamicResource TextBlockStyle}" Grid.Row="2" Margin="0 15 0 0"/>
                        <PasswordBox PasswordChar="{Binding txtPasswordLogin}"  Style="{DynamicResource PasswordBoxStyle}" Grid.Row="3"/>


                        <Button Command="{Binding BtnSendLogin}"  Style="{DynamicResource ButtonStyle}" Content="Войти" Grid.Row="4"
                        HorizontalAlignment="Center" Padding="5" Width="100" Margin="15"/>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Регистрация">

                <Border Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Логин" Grid.Row="0"/>
                        <TextBox Text="{Binding txtLoginRegister}" Grid.Row="1"/>

                        <TextBlock Text="Имя" Grid.Row="2" Margin="0 15 0 0"/>
                        <TextBox Text="{Binding txtFirstNameRegister}" Grid.Row="3"/>

                        <TextBlock Text="Фамилия" Grid.Row="4" Margin="0 15 0 0"/>
                        <TextBox Text="{Binding txtLastNameRegister}" Grid.Row="5"/>

                        <TextBlock Text="Отчество" Grid.Row="6" Margin="0 15 0 0"/>
                        <TextBox Text="{Binding txtMiddleRegister}" Grid.Row="7"/>

                        <TextBlock Text="Почта" Grid.Row="8" Margin="0 15 0 0"/>
                        <TextBox Text="{Binding txtEmailRegister}" Grid.Row="9"/>

                        <TextBlock Text="Пароль" Grid.Row="10" Margin="0 15 0 0"/>
                        <TextBox Text="{Binding txtPasswordRegister}" Grid.Row="11"/>
                        
                        <TextBlock Text="Подтвердите пароль" Grid.Row="12" Margin="0 15 0 0"/>
                        <TextBox Text="{Binding txtConfirmPasswordRegister}" Grid.Row="13"/>


                        <Button Command="{Binding BtnSendRegister}" Style="{DynamicResource ButtonStyle}" Content="Зарегистрироваться" Grid.Row="14"
                        HorizontalAlignment="Center" Padding="5" Width="125" Margin="15"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
