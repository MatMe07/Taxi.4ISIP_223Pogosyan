<Page x:Class="Taxi.WPF.Views.ProfilePages.ProfileEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      
      xmlns:local="clr-namespace:Taxi.WPF.ViewModels.ProfileViewModels"
      xmlns:localConverters="clr-namespace:Taxi.WPF.Converters"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      
      d:Background="{StaticResource AppBackgroundBrush}"
      d:DataContext="{d:DesignInstance {x:Type local:ProfileEditViewModel}}"
      mc:Ignorable="d" d:DesignWidth="800"
      x:Name="page"
      
      Title="ProfileEditPage" d:Height="554"
      
      >

    <Page.Resources>
        <localConverters:BoolToVisibilityConverter x:Key="boolToVisibilityConverter"/>
    </Page.Resources>

    <Grid >
        <Grid HorizontalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Auto" MinWidth="100" MaxWidth="450" Grid.Row="2">
                <StackPanel Margin="20"  HorizontalAlignment="Left">
                    <TextBlock  Style="{StaticResource AppTextBlockTitle}" Text="Личные данные" Margin="0 0 0 10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" Margin="0 5 5 5" MinWidth="190"
                     Style="{StaticResource AppTextBox}"
                     materialDesign:HintAssist.Hint="ФИО"
                     Text="{Binding DisplayName, Mode=TwoWay}"/>

                        <TextBox Grid.Row="0" Grid.Column="1" Margin="5 5 0 5"
                     Style="{StaticResource AppTextBox}"  MinWidth="190"
                     materialDesign:HintAssist.Hint="Логин"
                     IsReadOnly="True"
                                 ToolTip="Нельзя редактировать"
                     Text="{Binding Login}"/>


                        <xctk:MaskedTextBox Grid.Row="1" Grid.Column="0" Margin="0 5 5 5"
                     Style="{StaticResource TextBoxPhone}"
                     materialDesign:HintAssist.Hint="Телефон"
                     Text="{Binding Phone, Mode=TwoWay}"/>

                    </Grid>

                    <Button Content="Сохранить изменения"
                Style="{StaticResource buttonBased}"
                Command="{Binding SaveProfileCommand}"
                IsEnabled="{Binding IsEnabledButton}"
                HorizontalAlignment="Left"
                Margin="0 15 0 0"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0 25" />

                    <TextBlock Style="{StaticResource AppTextBlockTitle}" Text="Безопасность" Margin="0 0 0 10"/>

                    <StackPanel Orientation="Horizontal" >
                        <Button Content="Сменить пароль"
                    Style="{StaticResource buttonBased}"
                            x:Name="ChangePasswordButton"
                    Command="{Binding OpenChangePasswordCommand}"
                    />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
            <Border Height="270"
               Visibility="{Binding IsChangePasswordOpen, Converter={StaticResource boolToVisibilityConverter}}"
                    Style="{DynamicResource PasswordPopupBorder}" d:Visibility="Collapsed">
                <StackPanel>

                    <TextBlock Style="{StaticResource AppTextBlockTitle}"
                           Text="Смена пароля"
                           Margin="0 0 0 15"/>

                    <PasswordBox Style="{StaticResource AppPasswordBox}"
                         materialDesign:HintAssist.Hint="Текущий пароль"
                         x:Name="passwordCur"
                         Margin="0 0 0 10" PasswordChanged="PasswordBoxCurrent_PasswordChanged"/>

                    <PasswordBox Style="{StaticResource AppPasswordBox}"
                         materialDesign:HintAssist.Hint="Новый пароль"
                         x:Name="passwordNew"
                         Margin="0 0 0 10" PasswordChanged="PasswordBoxNEW_PasswordChanged"/>

                    <PasswordBox Style="{StaticResource AppPasswordBox}"
                         materialDesign:HintAssist.Hint="Повторите новый пароль"
                                     x:Name="passwordNewConfirm"
                                     
                         Margin="0 0 0 15" PasswordChanged="PasswordBoxNewConfirm_PasswordChanged"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена"
                        Style="{StaticResource SecondaryButtonBased}"
                        Command="{Binding CloseChangePasswordCommand}"
                                    
                                    />
                        <Button Content="Сохранить"
                            Style="{StaticResource buttonBased}"
                            Command="{Binding SavePasswordCommand}"
                            Padding="15 8"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
