<Page x:Class="Taxi.WPF.Views.ProfilePages.ProfileEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      
      xmlns:local="clr-namespace:Taxi.WPF.ViewModels.ProfileViewModels"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      
      d:Background="{StaticResource AppBackgroundBrush}"
      mc:Ignorable="d" d:DesignWidth="800"
      x:Name="page"
      
      Title="ProfileEditPage" d:Height="554"
      
      >


    <Grid >
        <Grid HorizontalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Auto" MinWidth="100" MaxWidth="450" Grid.Row="2">
                <StackPanel Margin="20"  HorizontalAlignment="Left">
                    <TextBlock  Style="{StaticResource AppTextBlockTitle}" Text="Личные данные" Margin="0 0 0 10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" Margin="0 5 5 5" MinWidth="190"
                     Style="{StaticResource AppTextBox}"
                     materialDesign:HintAssist.Hint="ФИО"
                     Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Grid.Row="0" Grid.Column="1" Margin="5 5 0 5"
                     Style="{StaticResource AppTextBox}"  MinWidth="190"
                     materialDesign:HintAssist.Hint="Логин"
                     IsReadOnly="True"
                     Text="{Binding User.Login}"/>


                        <xctk:MaskedTextBox Grid.Row="1" Grid.Column="0" Margin="0 5 5 5"
                     Style="{StaticResource TextBoxPhone}"
                     materialDesign:HintAssist.Hint="Телефон"
                     Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    </Grid>

                    <Button Content="Сохранить изменения"
                Style="{StaticResource buttonBased}"
                Command="{Binding SaveProfileCommand}"
                IsEnabled="{Binding IsEnabledButton}"
                HorizontalAlignment="Left"
                Margin="0 15 0 0"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0 25" />

                    <TextBlock Style="{StaticResource AppTextBlockTitle}" Text="Безопасность" Margin="0 0 0 10"/>

                    <StackPanel Orientation="Horizontal" >
                        <Button Content="Сменить пароль"
                    Style="{StaticResource buttonBased}"
                            x:Name="ChangePasswordButton"
                    Command="{Binding OpenChangePasswordCommand}"
                    />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
            <Popup x:Name="ChangePasswordPopup"
               IsOpen="{Binding IsChangePasswordOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=page}"
               Placement="Center"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="0"
               VerticalOffset="8">

                <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
             
            Padding="20"
            Width="320">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>

                    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">

                        <TextBlock Style="{StaticResource AppTextBlockTitle}"
                           Text="Смена пароля"
                           Margin="0 0 0 15"/>

                        <PasswordBox Style="{StaticResource AppPasswordBox}"
                         materialDesign:HintAssist.Hint="Текущий пароль"
                         
                         Margin="0 0 0 10"/>

                        <PasswordBox Style="{StaticResource AppPasswordBox}"
                         materialDesign:HintAssist.Hint="Новый пароль"
                         
                         Margin="0 0 0 10"/>

                        <PasswordBox Style="{StaticResource AppPasswordBox}"
                         materialDesign:HintAssist.Hint="Повторите новый пароль"
                         Margin="0 0 0 15"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена"
                        Style="{StaticResource buttonBased}"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Foreground="{DynamicResource TextBlockPrimaryBrush}"
                        Command="{Binding CloseChangePasswordCommand}"
                        Margin="0 0 10 0"
                        Padding="15 8"/>
                            <Button Content="Сохранить"
                            Style="{StaticResource buttonBased}"
                            Command="{Binding SavePasswordCommand}"
                            IsEnabled="{Binding IsPasswordValid}"
                            Padding="15 8"/>
                        </StackPanel>
                        
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Page>
