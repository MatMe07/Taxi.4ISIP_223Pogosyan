<Page x:Class="Taxi.WPF.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Taxi.WPF.Views"
      mc:Ignorable="d"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      
      d:Background="White"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        
        <Border VerticalAlignment="Top" Margin="10" Style="{StaticResource borderNav}">


            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="CASE" Style="{DynamicResource AppTextBlockTitle}" Grid.Column="0"/>
                
                
                <Button Grid.Column="2">
                    <materialDesign:PackIcon/>
                    
                </Button>
            </Grid>
        </Border>

        <Frame NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
