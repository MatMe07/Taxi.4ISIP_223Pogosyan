<Page x:Class="Taxi.WPF.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Taxi.WPF.Views"
      mc:Ignorable="d"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      
      d:Background="White"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage" Loaded="Page_Loaded">

    <Grid>
        
        <Border VerticalAlignment="Top" Margin="10" Style="{StaticResource borderNav}" Panel.ZIndex="1">


            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="CASE" Style="{DynamicResource AppTextBlockTitle}" Grid.Column="0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Grid.Column="2" Margin="20  0"  Command="{Binding BtnThemsCommand}" Style="{DynamicResource buttonBased}" >
                        <materialDesign:PackIcon Kind="ThemeLightDark" Width="25" Height="25"/>
                    
                    </Button>
                    <Button Grid.Column="2"  Style="{DynamicResource buttonBased}" >
                        <materialDesign:PackIcon Kind="Account" Width="25" Height="25" />
                    
                    </Button>
                    
                </StackPanel>
            </Grid>
        </Border>

        <Frame NavigationUIVisibility="Hidden" x:Name="frameMain"/>
    </Grid>
</Page>
