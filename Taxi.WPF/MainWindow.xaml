<Window x:Class="Taxi.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Taxi.WPF.ViewModels"
        xmlns:localConverters="clr-namespace:Taxi.WPF.Converters"
        
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="Taxi App" MinWidth="830" Closed="Window_Closed"
        MinHeight="610"
        d:Background="{DynamicResource AppBackgroundBrush}"
        Style="{DynamicResource WindowStyle}" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <localConverters:BoolToVisibilityConverter x:Key="boolToVisibilityConverter"/>
    </Window.Resources>
    <materialDesign:DialogHost Identifier="AddVehicleDialog"
                               
                               DialogTheme="Inherit">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border VerticalAlignment="Top" Margin="10"
                Style="{DynamicResource borderNav}"
                 Panel.ZIndex="1">


                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Вези!" Grid.Column="0" Style="{DynamicResource  buttonIconCLick}"
                        materialDesign:RippleAssist.IsDisabled="True"
                        Command="{Binding BtnIconClickCommand}"
                        />
                    <!--<TextBlock Text="CASE" Style="{DynamicResource AppTextBlockTitle}" Grid.Column="0"/>-->

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Grid.Column="2" Margin="20  0"  Command="{Binding BtnThemsCommand}" Style="{DynamicResource buttonBased}" >
                            <materialDesign:PackIcon Kind="ThemeLightDark" Width="25" Height="25"/>

                        </Button>
                        <Button Grid.Column="2" 
                            Style="{DynamicResource buttonBased}" Command="{Binding CommandOpenProfile}">
                            <materialDesign:PackIcon Kind="Account" Width="25" Height="25" />

                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <Frame NavigationUIVisibility="Hidden" Grid.Row="{Binding RowFrame}" Grid.RowSpan="2" x:Name="frameMain"/>
            <Border Background="#7F262633" d:Visibility="Collapsed" Panel.ZIndex="2" Grid.RowSpan="3"  Visibility="{Binding IsBlurVisible, Converter={StaticResource boolToVisibilityConverter}}"/>

        </Grid>
    </materialDesign:DialogHost>
</Window>
